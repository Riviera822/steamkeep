# Shell scripts under poc/linux-client-test/ run INSIDE WSL2/Ubuntu (Linux) -
# force LF line endings regardless of the checkout platform or any local
# core.autocrlf setting, so a Windows checkout never silently reintroduces
# CRLF (which breaks `#!/usr/bin/env bash` shebangs and confuses bash).
poc/linux-client-test/*.sh eol=lf
