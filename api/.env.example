# Copy this file to .env and fill in real values. Never commit the real .env.

# Required. Shared secret clients send in the X-Api-Key header.
# No default on purpose — vault-api refuses to start without it.
VAULT_API_KEY=changeme-generate-a-long-random-string

# Optional. Path to the SQLite database file.
VAULT_DB_PATH=./vault.db

# Optional. Root directory for the depot cache — the same directory vault-core
# stores into. vault-api diffs <VAULT_CACHE_ROOT>/depot/<depotid>/ before and
# after a prefill to learn which depots belong to which app.
VAULT_CACHE_ROOT=./cache

# Optional. Log level: DEBUG, INFO, WARNING, ERROR.
VAULT_LOG_LEVEL=INFO

# Optional (required to actually RUN prefill jobs). Full path to the
# SteamPrefill executable. Unset = vault-api still starts and serves everything
# else; prefill jobs then fail with a clear message instead of the app refusing
# to boot. Log in once interactively before the first job:
#   SteamPrefill select-apps
# vault-api never handles Steam credentials — SteamPrefill keeps its own session
# in Config/ next to the executable. NOTE: vault-api overwrites
# Config/selectedAppsToPrefill.json on every job (that file is the only
# non-interactive way to select a specific app id).
VAULT_STEAMPREFILL_PATH=

# Optional. Hard time budget for a single SteamPrefill run, in seconds. This is
# a hang backstop, not a performance knob — a large game on a slow line
# legitimately takes hours. Default: 14400 (4 h).
VAULT_PREFILL_TIMEOUT_SECONDS=14400

# Optional. How long the job worker sleeps between polls of an empty queue,
# in seconds. Default: 1.0.
VAULT_WORKER_POLL_SECONDS=1.0

# Optional. TTL (seconds) for the in-process per-game size cache (plan §3:
# "du over depot folders, cached"). A disk walk over the whole depot/ tree
# costs real time on a large cache, so GET /v1/games and
# GET /v1/cache/summary reuse the last scan within this window. Invalidated
# immediately after a successful prefill job, so a game's size is never more
# than VAULT_SIZE_CACHE_TTL seconds stale for an idle cache, or fresh right
# after you fill/delete something. Default: 60.
VAULT_SIZE_CACHE_TTL=60
