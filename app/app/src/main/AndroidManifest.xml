<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup is deliberately false: a later WP (4b.2) stores a
         vault-api key in this app's private storage. Auto Backup
         (android:allowBackup="true", the default) would ship that key to
         the user's cloud backup / off-device on uninstall+reinstall — the
         same class of leak the WP 4b.1 review flagged before any secret
         actually exists here, so the setting is correct from the first
         commit rather than retrofitted later. dataExtractionRules is the
         Android 12+ counterpart: allowBackup alone only governs cloud
         backup on API 31+, not device-to-device transfer, which needs its
         own exclusion (res/xml/data_extraction_rules.xml). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SteamVault"
        android:supportsRtl="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SteamVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
