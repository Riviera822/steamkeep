<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons (required by the AGP lint
  MonochromeLauncherIcon check). Same shield silhouette as
  ic_launcher_foreground.xml, filled solid white — the system applies its
  own single-colour tint on top when a themed-icon-enabled launcher is
  active, so the actual fill colour here is irrelevant beyond
  opaque-vs-transparent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,24 L78,34 V56 C78,72 68,82 54,88 C40,82 30,72 30,56 V34 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:fillColor="#00000000" />
    <path
        android:pathData="M44,56 L51,63 L66,46"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
