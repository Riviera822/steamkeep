    <string name="reduced_motion_off">Reduced motion: OFF (animations enabled)</string>

    <!-- Steam identity screen (WP 4b.3). Library grid rendering is WP 4b.4;
         this screen only shows a game-count preview (WP brief boundary). -->
    <string name="identity_title">Steam account</string>
    <string name="identity_signed_out_hint">Sign in with your Steam account to link it to this device.</string>
    <string name="identity_sign_in">Sign in with Steam</string>
    <string name="identity_sign_out">Sign out</string>
